# Copied to .env by `npm run setup` (existing values are never overwritten).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://portal:portal@127.0.0.1:5433/portal
REDIS_URL=redis://127.0.0.1:6379

# Generated by setup
JWT_SECRET=
MEDIA_TOKEN_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browsers connect here; the API's server SDK uses LIVEKIT_API_URL
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://127.0.0.1:7880

# Recordings: host folder (relative to apps/api) and the same folder as seen inside the Egress container
RECORDINGS_DIR=../../data/recordings
EGRESS_OUTPUT_DIR=/out

# Your keys (needed only for transcripts and summaries)
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

MAX_CALL_MINUTES=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Optional: use an existing ffmpeg instead of the bundled one
FFMPEG_PATH=
