# LiveKit server config (local development). Filled in by `npm run setup`.
port: 7880
bind_addresses:
  - 0.0.0.0
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: false
  # Offer two addresses for media:
  #  - 127.0.0.1 (loopback): browsers on this machine reach it through the published ports
  #  - the container's own IP: the recorder's headless Chrome (Egress) reaches it directly.
  #    Chrome will not connect from a container address to a loopback one, so a
  #    127.0.0.1-only setup breaks the composite recording.
  enable_loopback_candidate: true
redis:
  address: redis:6379
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
webhook:
  api_key: __LIVEKIT_API_KEY__
  urls:
    - http://host.docker.internal:4610/api/livekit/webhook
room:
  empty_timeout: 300
logging:
  level: info
