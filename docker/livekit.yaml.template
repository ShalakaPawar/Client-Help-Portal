# LiveKit server config (local development). Filled in by `npm run setup`.
port: 7880
bind_addresses:
  - 0.0.0.0
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: false
  # Browsers on this machine reach the container through the published 127.0.0.1 ports.
  node_ip: 127.0.0.1
redis:
  address: redis:6379
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
webhook:
  api_key: __LIVEKIT_API_KEY__
  urls:
    - http://host.docker.internal:3000/api/livekit/webhook
room:
  empty_timeout: 300
logging:
  level: info
